# ═══════════════════════════════════════════════════════════════
# Health Triage Locator — variáveis de ambiente
# Copie para .env.local e preencha o que for necessário.
# NUNCA comite o arquivo .env.local (já está no .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Obrigatórias para funcionar (com valores padrão sensatos) ──

# Coordenadas padrão (Manaus) quando o usuário não informa localização
DEFAULT_LAT=-3.1019
DEFAULT_LNG=-60.0250

# Raio de busca do fluxo principal: configurado por requisição (1 a 10 km),
# padrão 10 km quando não informado (slider na UI e campo radius_km na API).

# ── Opcionais ──

# Endpoint Overpass (padrão já tem fallback para lz4 e endpoints principais)
# OVERPASS_API_URL=https://lz4.overpass-api.de/api/interpreter

# Nominatim (geocodificação). Informe um e-mail para uso educado na API pública.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_EMAIL=seu-email@exemplo.com

# Triagem por IA (opcional). Sem a chave, o sistema usa apenas a base de
# conhecimento local + fallback conservador — funciona offline de IA.
# GEMINI_API_KEY=

# CORS em produção: liste os domínios permitidos separados por vírgula.
# ALLOWED_ORIGINS=https://seu-dominio.vercel.app
